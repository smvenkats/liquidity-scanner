# Copy to .env for LOCAL dev (gitignored). On Railway, set these as service Variables
# in the dashboard — do NOT commit real secrets.

# --- Broker data (your personal Questrade refresh token) ---
QUESTRADE_REFRESH_TOKEN=            # generate from a Questrade personal app; set on Railway
QUESTRADE_TOKEN_CACHE=/data/.questrade_token.json   # rotated-token cache (on the volume)

# --- Dashboard login (shared family Basic Auth) ---
DASH_USER=family
DASH_PASSWORD=change-me

# --- Periodic scan ---
SCAN_ENABLED=false                 # set "true" on Railway to run the in-process scan
SCAN_INTERVAL_MIN=60               # minutes between scans (each refetches 5m, ~5 min)

# --- Storage (point at the Railway volume) ---
SIGNALS_PATH=/data/signals.jsonl
BARS_DIR=/data/bars

# Note: locally these default to .tmp/signals.jsonl and .tmp/bt_data if unset.
